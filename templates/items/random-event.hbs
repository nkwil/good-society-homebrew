<section class="gs-item-sheet__wrapper">
<form class="gs-item-sheet__form" autocomplete="off">

  <header class="gs-item-sheet__header">
    <div class="gs-item-sheet__header-row">
      <span class="gs-item-sheet__eyebrow">{{localize "GOODSOCIETY.item.randomEvent.eyebrow"}}</span>
    </div>
    {{!-- name= stripped on purpose: the sheet autosaves via a change listener
          wired in _onRender (see random-event-sheet.js) so form-serializer
          races can't stomp a mid-edit title. --}}
    <input class="gs-item-sheet__name"
           type="text"
           data-gs-field="name"
           value="{{document.name}}"
           placeholder="{{localize "GOODSOCIETY.item.randomEvent.namePlaceholder"}}" />
  </header>

  <div class="gs-item-sheet__body">

    {{!-- Archetype filter --}}
    <div class="gs-item-sheet__field">
      <label class="gs-item-sheet__label" for="gs-rev-archetype">
        {{localize "GOODSOCIETY.item.randomEvent.archetypeLabel"}}
      </label>
      <select id="gs-rev-archetype"
              class="gs-item-sheet__input"
              data-gs-field="archetype">
        {{#each archetypeChoices}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <p class="gs-item-sheet__hint">{{localize "GOODSOCIETY.item.randomEvent.archetypeHint"}}</p>
    </div>

    {{!-- Flavor image (optional). Shown to all players when the event
          launches, and in the resolution popover. --}}
    <div class="gs-item-sheet__field">
      <span class="gs-item-sheet__label">{{localize "GOODSOCIETY.item.randomEvent.imageLabel"}}</span>
      <p class="gs-item-sheet__hint">{{localize "GOODSOCIETY.item.randomEvent.imageHint"}}</p>
      <div class="gs-random-event-image__row">
        <button type="button"
                class="gs-random-event-image__thumb {{#unless hasImage}}gs-random-event-image__thumb--empty{{/unless}}"
                data-action="pickImage"
                title="{{localize 'GOODSOCIETY.item.randomEvent.imagePick'}}"
                aria-label="{{localize 'GOODSOCIETY.item.randomEvent.imagePick'}}">
          {{#if hasImage}}
            <img src="{{imageUrl}}" alt="" />
          {{else}}
            <span aria-hidden="true">+</span>
          {{/if}}
        </button>
        <div class="gs-random-event-image__actions">
          <button type="button" class="gs-btn gs-btn--ghost gs-btn--sm" data-action="pickImage">
            {{#if hasImage}}
              {{localize "GOODSOCIETY.item.randomEvent.imageChange"}}
            {{else}}
              {{localize "GOODSOCIETY.item.randomEvent.imagePick"}}
            {{/if}}
          </button>
          {{#if hasImage}}
            <button type="button" class="gs-btn gs-btn--ghost gs-btn--sm" data-action="clearImage">
              {{localize "GOODSOCIETY.item.randomEvent.imageClear"}}
            </button>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- Description — read-only enriched render + ✎ edit button. --}}
    <div class="gs-item-sheet__field">
      <div class="gs-item-sheet__label-row">
        <span class="gs-item-sheet__label">{{localize "GOODSOCIETY.item.randomEvent.descriptionLabel"}}</span>
        <button type="button" class="gs-item-sheet__edit-btn"
                data-action="editDescription"
                title="{{localize 'GOODSOCIETY.common.edit'}}"
                aria-label="{{localize 'GOODSOCIETY.common.edit'}}">
          <span aria-hidden="true">✎</span>
        </button>
      </div>
      <div class="gs-item-sheet__description-body">
        {{#if enrichedDescription}}
          {{{enrichedDescription}}}
        {{else}}
          <p class="gs-item-sheet__description-placeholder"><em>{{localize "GOODSOCIETY.common.noDescription"}}</em></p>
        {{/if}}
      </div>
    </div>

    {{!-- Positive tag SUGGESTIONS. Click-to-prefill chips the player sees
          when they succeed; they can also type their own. --}}
    <div class="gs-item-sheet__field">
      <div class="gs-rev-shortlist__header">
        <span class="gs-item-sheet__label gs-item-sheet__label--positive">
          ▲ {{localize "GOODSOCIETY.item.randomEvent.positiveLabel"}}
        </span>
        <button type="button"
                class="gs-btn gs-btn--ghost gs-btn--sm"
                data-action="addPositiveTag">
          + {{localize "GOODSOCIETY.item.randomEvent.addOption"}}
        </button>
      </div>
      <p class="gs-item-sheet__hint">{{localize "GOODSOCIETY.item.randomEvent.positiveHint"}}</p>
      {{#each positiveTagOptions}}
        <div class="gs-rev-shortlist__row">
          <input class="gs-item-sheet__input"
                 type="text"
                 data-gs-side="positive"
                 data-index="{{@index}}"
                 value="{{this}}"
                 placeholder="{{localize "GOODSOCIETY.item.randomEvent.optionPlaceholderPositive"}}" />
          <button type="button"
                  class="gs-btn gs-btn--ghost gs-btn--sm gs-rev-shortlist__remove"
                  data-action="removePositiveTag"
                  data-index="{{@index}}"
                  title="{{localize 'GOODSOCIETY.item.randomEvent.removeOption'}}">×</button>
        </div>
      {{/each}}
    </div>

    {{!-- Negative tag SUGGESTIONS. Same deal on a failure. --}}
    <div class="gs-item-sheet__field">
      <div class="gs-rev-shortlist__header">
        <span class="gs-item-sheet__label gs-item-sheet__label--negative">
          ▼ {{localize "GOODSOCIETY.item.randomEvent.negativeLabel"}}
        </span>
        <button type="button"
                class="gs-btn gs-btn--ghost gs-btn--sm"
                data-action="addNegativeTag">
          + {{localize "GOODSOCIETY.item.randomEvent.addOption"}}
        </button>
      </div>
      <p class="gs-item-sheet__hint">{{localize "GOODSOCIETY.item.randomEvent.negativeHint"}}</p>
      {{#each negativeTagOptions}}
        <div class="gs-rev-shortlist__row">
          <input class="gs-item-sheet__input"
                 type="text"
                 data-gs-side="negative"
                 data-index="{{@index}}"
                 value="{{this}}"
                 placeholder="{{localize "GOODSOCIETY.item.randomEvent.optionPlaceholderNegative"}}" />
          <button type="button"
                  class="gs-btn gs-btn--ghost gs-btn--sm gs-rev-shortlist__remove"
                  data-action="removeNegativeTag"
                  data-index="{{@index}}"
                  title="{{localize 'GOODSOCIETY.item.randomEvent.removeOption'}}">×</button>
        </div>
      {{/each}}
    </div>

  </div>

  <footer class="gs-item-sheet__footer">
    <button type="button" class="gs-btn gs-btn--primary" data-action="done">
      {{localize "GOODSOCIETY.item.done"}}
    </button>
  </footer>

</form>
</section>
