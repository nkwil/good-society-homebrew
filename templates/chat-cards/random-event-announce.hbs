<div class="gs-chat-card gs-random-event-announce">
  <header class="gs-chat-card__header">
    <div class="gs-chat-card__speaker">
      {{#if targetPortraitUrl}}
        <img class="gs-chat-card__portrait" src="{{targetPortraitUrl}}" alt="{{targetName}}" />
      {{else}}
        <span class="gs-chat-card__initial">{{targetInitial}}</span>
      {{/if}}
      <div class="gs-chat-card__speaker-info">
        <span class="gs-chat-card__speaker-name">{{targetName}}</span>
        <span class="gs-chat-card__eyebrow">{{eyebrow}}</span>
      </div>
    </div>
  </header>

  {{#if eventImageUrl}}
    <img class="gs-random-event-announce__image" src="{{eventImageUrl}}" alt="" />
  {{/if}}

  <h3 class="gs-random-event-announce__title">{{eventName}}</h3>

  {{#if eventDescription}}
    <div class="gs-random-event-announce__desc">{{{eventDescription}}}</div>
  {{/if}}

  <p class="gs-random-event-announce__lead">{{bodyLead}}</p>
  <p class="gs-random-event-announce__waiting"><em>{{waiting}}</em></p>
</div>
