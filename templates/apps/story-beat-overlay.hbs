{{!-- Story Beat Overlay — frameless full-viewport. Outer shell handles
     palette + dismiss; the inner template (rendered via `innerHtml` in
     `_prepareContext`) carries the beat-specific visual content. --}}
<div class="gs-story-beat gs-story-beat--{{beat.paletteClass}}{{#if isPreview}} gs-story-beat--preview{{/if}}"
     role="dialog"
     aria-label="{{beat.label}}">
  <div class="gs-story-beat__veil" aria-hidden="true"></div>

  {{#if isPreview}}
    {{!-- GM dry-run badge: makes it unmistakable that players aren't
         seeing this. Positioned top-center so it doesn't fight the
         dismiss button in the top-right corner. --}}
    <div class="gs-story-beat__preview-badge" aria-label="{{localize 'GOODSOCIETY.storyBeats.previewBadge'}}">
      <span class="gs-story-beat__preview-dot" aria-hidden="true">●</span>
      {{localize "GOODSOCIETY.storyBeats.previewBadge"}}
    </div>
  {{/if}}

  <div class="gs-story-beat__content">
    {{{innerHtml}}}
  </div>

  {{#if canDismiss}}
    <button type="button"
            class="gs-story-beat__dismiss"
            data-action="dismiss"
            aria-label="{{localize 'GOODSOCIETY.storyBeats.dismiss'}}">
      <span class="gs-story-beat__dismiss-label">{{localize "GOODSOCIETY.storyBeats.dismiss"}}</span>
      <span class="gs-story-beat__dismiss-x" aria-hidden="true">×</span>
    </button>
  {{/if}}
</div>
