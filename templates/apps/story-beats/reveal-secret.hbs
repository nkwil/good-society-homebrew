{{!-- Reveal a Secret — hushed slow fade. --}}
<article class="gs-beat-reveal">
  <p class="gs-beat-reveal__eyebrow">{{localize "GOODSOCIETY.storyBeats.reveal.eyebrow"}}</p>
  {{#if payload.subject}}
    <p class="gs-beat-reveal__subject"><em>{{payload.subject}}</em></p>
  {{/if}}
  <p class="gs-beat-reveal__secret">{{payload.secret}}</p>
</article>
