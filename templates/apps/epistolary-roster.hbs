{{!--
  Epistolary Roster — GM-side companion to the wizard. Shows mark-done
  status per Major for the current cycle.
--}}
<section class="gs-epistolary-roster">
  <header>
    <h2 class="gs-eyebrow">
      {{localize "GOODSOCIETY.epistolary.roster.heading"}} · {{localize "GOODSOCIETY.cycle.label"}} {{cycleNumber}}
    </h2>
  </header>

  <ul class="gs-epistolary-roster__list">
    {{#each majors}}
      <li class="gs-epistolary-roster__row gs-themed" data-theme="{{theme}}">
        <span class="gs-epistolary-roster__portrait">
          {{#if portrait}}
            <img src="{{portrait}}" alt="" />
          {{else}}
            <span class="gs-epistolary-roster__portrait-initial">{{firstLetter name}}</span>
          {{/if}}
        </span>
        <span class="gs-epistolary-roster__name">{{name}}</span>
        {{#if done}}
          {{!-- GM-only: click the ✓ to roll back the player's mark-done.
               Renders as a button so it gets normal hover affordance + keyboard
               focus. The pending state stays a plain span (nothing to undo). --}}
          <button type="button"
                  class="gs-epistolary-roster__status gs-epistolary-roster__status--undoable is-done"
                  data-action="unmarkDone"
                  data-actor-id="{{id}}"
                  title="{{localize "GOODSOCIETY.epistolary.roster.unmarkTitle"}}"
                  aria-label="Un-mark {{name}} as done">
            ✓
          </button>
        {{else}}
          <span class="gs-epistolary-roster__status is-pending">⏳</span>
        {{/if}}
      </li>
    {{/each}}
  </ul>

  <footer class="gs-epistolary-roster__foot">
    {{summary}}
  </footer>
</section>
